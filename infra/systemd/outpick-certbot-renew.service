[Unit]
Description=Renew OUTPICK TLS certificate and reload Nginx
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/outpick
ExecStart=/usr/bin/bash /home/ubuntu/outpick/scripts/renew-certificates.sh
UMask=0077
